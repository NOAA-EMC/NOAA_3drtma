# ignore vim temporary file (*.swp)
#
*.swp
#
# # ignore building directory ('build/'), directory of executable files ('exec/','bin/')
#
#
**/exec/
**/bin/
#
**/build_*/
#
#
sorc/logs/**
#
#
# # ignore directory of log files ('log/', 'logs/')
#
#
#
workflow/*.log
workflow/logs/**
#
#  
#
#  # ignore rocoto database files ('*.db')
#
*.db
#
#  # ignore object/executable/lib/module file ('*.o, *.x, *.exei, *.a, *.mod')
#
*.o
!sorc/rtma_wrfbufr_conus.fd/wrflibs/*.o
!sorc/rtma_wrfbufr_alaska.fd/wrflibs/*.o
*.a
!sorc/rtma_wrfbufr_conus.fd/wrflibs/*.a
!sorc/rtma_wrfbufr_alaska.fd/wrflibs/*.a
*.x
*.exe
sorc/**/*.mod
sorc/rtma3d_obslist.fd/rtma3d_obslist
sorc/rtma3d_process_cloud.fd/rtma3d_process_cloud
sorc/rtma3d_process_lightning.fd/rtma3d_process_lightning
sorc/rtma3d_process_mosaic.fd/rtma3d_process_mosaic
sorc/rtma3d_process_mosaic.fd/rtma3d_process_mosaic_enkf
sorc/rtma3d_smartinit.fd/rtma3d_smartinit
sorc/rtma3d_sndp.fd/rtma3d_sndp
sorc/rtma3d_stnmlist.fd/rtma3d_stnmlist
sorc/rtma3d_wrfbufr_alaska.fd/rtma3d_wrfbufr_alaska
sorc/rtma3d_wrfbufr_conus.fd/rtma3d_wrfbufr_conus
sorc/rtma3d_maxrh.fd/rtma3d_maxrh
sorc/rtma3d_minrh.fd/rtma3d_minrh
sorc/rtma3d_maxtbg.fd/rtma3d_maxtbg
sorc/rtma3d_mintbg.fd/rtma3d_mintbg
# # ignore sub-directory ('run/') under rtma3d_wrfarw.fd 
#sorc/rtma3d_wrfarw.fd/WRFV3.9/run/
#
parm
fix
#  # ignore the sub-directories (build/install/fix) under gsi package
#  # but track the source code of gsi package
sorc/rtma3d_gsi.fd/build/
sorc/rtma3d_gsi.fd/install/
sorc/rtma3d_gsi.fd/fix/
sorc/rtma3d_gsi.fd/ush/build_gsi4rtma3d*.sh
sorc/rtma3d_gsi.fd/.git/
sorc/rtma3d_gsi.fd/.github/
#  # ignore the sub-directories (build/install/logs) under post(upp) package
#  # but track the source code, fix and parm of upp package
sorc/rtma3d_post.fd/tests/install/
sorc/rtma3d_post.fd/tests/build/
sorc/rtma3d_post.fd/tests/logs/
sorc/rtma3d_post.fd/.git/
sorc/rtma3d_post.fd/.github/
!sorc/rtma3d_post.fd/parm/
!sorc/rtma3d_post.fd/fix/
!sorc/rtma3d_post.fd/tests/logs/rt.log.*
#
#  # ignore the link files under directory modulefiles
#
modulefiles/*/build/build_ncep_post.*
#
#  # ignore directory of development ('dev')
#
**/dev/
#
**/untrack/
#
**/tags
#
#  # special ignoring rules for workflow/
#
#
workflow/*.db
#
#
#  # exceptional pattern is led by sign "!"
#
