# ignore vim temporary file (*.swp)
#
*.swp
#
# # ignore building directory ('build/'), directory of executable files ('exec/','bin/')
#
#
**/exec/
**/bin/
#
**/build_*/
#
sorc/**/log.*
#
sorc/**/log_*
#
#
# # ignore directory of log files ('log/', 'logs/')
#
**/log/
#
**/logs/
#
**/log.*
log
logs
loghistory
run/
save4later
workflow/*.log
#
#  
#
#  # ignore rocoto database files ('*.db')
#
*.db
#
#  # ignore object/executable/lib/module file ('*.o, *.x, *.exei, *.a, *.mod')
#
*.o
!sorc/rtma_wrfbufr_conus.fd/wrflibs/*.o
!sorc/rtma_wrfbufr_alaska.fd/wrflibs/*.o
*.a
!sorc/rtma_wrfbufr_conus.fd/wrflibs/*.a
!sorc/rtma_wrfbufr_alaska.fd/wrflibs/*.a
*.x
*.exe
sorc/**/*.mod
#
#  # ignore directory of gsi and post(upp) source code ('sorc/rtma_gsi.fd, sorc/rtma_post.fd')
#
sorc/rtma_gsi.fd/*
parm/
!sorc/rtma_post.fd/parm
fix/
#
#  # ignore the link files under directory modulefiles
#
modulefiles/*/build/build_ncep_post.*
#
#  # ignore directory of development ('dev')
#
**/dev/
#
**/untrack/
#
**/tags
#
#  # special ignoring rules for workflow/
#
#
workflow/*.db
#
#
#  # exceptional pattern is led by sign "!"
#
